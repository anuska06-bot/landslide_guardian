{
  "version": 2,
  "builds": [
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://YOUR-RAILWAY-DOMAIN.up.railway.app/api/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "https://YOUR-RAILWAY-DOMAIN.up.railway.app/uploads/$1"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
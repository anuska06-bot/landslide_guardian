# =========================================================
# LANDSLIDE GUARDIAN — ENVIRONMENT CONFIGURATION
# =========================================================

# --- DATABASE (MongoDB Atlas or in-memory fallback) ---
# Paste your MongoDB Atlas SRV connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/landslide_guardian?retryWrites=true&w=majority

# --- SMTP EMAIL CONFIGURATION (Required for real OTP & SOS delivery) ---
# For Gmail:
# 1. Enable 2-Step Verification in Google Account (myaccount.google.com/security)
# 2. Generate a 16-character App Password (myaccount.google.com/apppasswords)
# 3. Enter your Gmail and the 16-letter App Password below (NOT your login password):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop
ALERT_FROM_EMAIL=your_email@gmail.com

# --- ADMIN CREDENTIALS & SECURITY ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=guardian-demo
ADMIN_SECRET=change-this-sih-production-secret

# --- BACKGROUND MONITORING & SOS DISPATCH ---
MONITOR_INTERVAL_MINUTES=15
SOS_COOLDOWN_MINUTES=60
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# --- SERVER PORT (Dynamic on Railway/Render, defaults to 8000 locally) ---
PORT=8000
